# Template only. Copy to .env.local and fill in; never commit .env.local.

# Postgres (Neon)
DATABASE_URL_OWNER=
DATABASE_URL_READER=

# MongoDB (Atlas)
MONGODB_URI=

# LLM
ANTHROPIC_API_KEY=
LLM_MODEL_PLANNER=claude-sonnet-5-5
LLM_MODEL_FAST=claude-haiku-5-5

# Services
PIPELINE_URL=http://localhost:8000

# Reference data (Phase 1b, offline only)
GEE_PROJECT=analytics-demo

# Guardrails
RATE_LIMIT_PER_IP_PER_DAY=15
MAX_OUTPUT_TOKENS=2000
DEMO_MODE=true
